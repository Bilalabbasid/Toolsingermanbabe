# ==============================================================================
# COOLWAVE — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment & URLs
NODE_ENV="production"
PORT="3000"
NEXT_PUBLIC_SITE_URL="https://coolwave.cool"
NEXTAUTH_URL="https://coolwave.cool"
NEXT_PUBLIC_ENABLE_ACCOUNTS="false"

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL mandatory)
# ------------------------------------------------------------------------------
# Production (Azure Database for PostgreSQL Flexible Server):
# DATABASE_URL="postgresql://cwadmin:YOUR_AZURE_PASSWORD@coolwave-pg-server.postgres.database.azure.com:5432/coolwave?sslmode=require"
#
# Local Docker Compose PostgreSQL:
# DATABASE_URL="postgresql://coolwave_user:coolwave_secure_pass@localhost:5432/coolwave_db?schema=public"
#
# Note: If unset in development, the app degrades gracefully with in-memory sessions.
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
AUTH_SECRET="generate-a-64-character-random-hex-string-for-production"
ADMIN_SECRET="optional-bearer-secret-for-cli-and-cron-jobs"

# Initial Administrator Seed (optional):
ADMIN_INITIAL_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# ------------------------------------------------------------------------------
# 3. STRIPE BILLING (Pro & Business Subscriptions)
# ------------------------------------------------------------------------------
# Leave empty to run in Graceful Fallback mode (all free features active, billing shows standby notice).
# Provide once your Stripe dashboard is ready:
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Separate recurring Stripe prices; the legacy STRIPE_PRO_PRICE_ID is accepted
# only as a monthly-price fallback.
STRIPE_PRICE_ID_PRO_MONTHLY=""
STRIPE_PRICE_ID_PRO_YEARLY=""
# Keep false until all live Stripe keys, prices and the webhook are configured.
NEXT_PUBLIC_ENABLE_STRIPE="false"

# ------------------------------------------------------------------------------
# 4. STORAGE & QUEUE (Optional / Ephemeral)
# ------------------------------------------------------------------------------
# Local ephemeral storage is used by default. For distributed cloud storage (e.g. Cloudflare R2):
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Redis Queue (for scaling conversion jobs across container nodes):
REDIS_URL=""

# ------------------------------------------------------------------------------
# 5. LIMITS & TIMEOUTS
# ------------------------------------------------------------------------------
TEMP_FILE_RETENTION_MINUTES="15"
PROCESSING_TIMEOUT_MS="60000"
OCR_TIMEOUT_MS="120000"
MAX_FILE_SIZE_FREE="50"
MAX_FILE_SIZE_PRO="500"
