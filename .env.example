# ==============================================================================
# DATEI TOOLS — VERCEL & PRODUCTION ENVIRONMENT CONFIGURATION
# https://datei-tools.de
# ==============================================================================

# ==============================================================================
# 1. REQUIRED FOR VERCEL DEPLOYMENT NOW
# ==============================================================================
# Canonical production site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://datei-tools.de"
NODE_ENV="production"

# ==============================================================================
# 2. OPTIONAL CONFIGURATION FOR VERCEL FRONTEND
# ==============================================================================
# Google AdSense Publisher ID (leave blank until approved)
NEXT_PUBLIC_ENABLE_ADS="true"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# Ad Slot IDs (defaults will be used if omitted)
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=""
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=""
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_TOP=""
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_CONTENT=""
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=""

# Disable accounts & stripe for initial free anonymous Vercel deployment
NEXT_PUBLIC_ENABLE_ACCOUNTS="false"
NEXT_PUBLIC_ENABLE_STRIPE="false"

# Allowed origins for CORS (comma-separated, no trailing slashes)
CORS_ALLOWED_ORIGINS="https://datei-tools.de,https://www.datei-tools.de"

# Free file size limit in MB (in-browser processing)
MAX_FILE_SIZE_FREE="50"

# ==============================================================================
# 3. AZURE-ONLY / FUTURE BACKEND WORKER INFRASTRUCTURE (Not needed on Vercel)
# ==============================================================================
# Database (PostgreSQL - for future user accounts and job history)
DATABASE_URL=""

# Authentication & Admin Security
AUTH_SECRET=""
ADMIN_SECRET=""
ADMIN_INITIAL_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# Remote Conversion Worker Base URL (when Azure backend worker is deployed)
NEXT_PUBLIC_API_BASE_URL=""
COOLWAVE_DEPLOYMENT_ROLE=""

# Stripe Billing (when paid tiers are activated)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO_MONTHLY=""
STRIPE_PRICE_ID_PRO_YEARLY=""
MAX_FILE_SIZE_PRO="500"

# Cloud Storage / R2 (for server-side temporary file storage)
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Redis Queue (for scaling asynchronous jobs across worker containers)
REDIS_URL=""

# Worker processing timeouts & retention
TEMP_FILE_RETENTION_MINUTES="15"
PROCESSING_TIMEOUT_MS="60000"
OCR_TIMEOUT_MS="120000"
